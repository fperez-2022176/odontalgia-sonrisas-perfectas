<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="820.0"
            styleClass="tratamiento-root"
            stylesheets="@../resources/styles/TratamientoStyles.css"
            xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ferp.system.controller.TratamientoController">

    <top>
        <VBox spacing="4.0" styleClass="tratamiento-header">
            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
            </padding>
            <children>
                <Label styleClass="tratamiento-titulo" text="Sonrisas Perfectas" />
                <Label styleClass="tratamiento-subtitulo" text="Catálogo de Tratamientos" />
                <Label fx:id="lblAvisoAdmin" managed="false" styleClass="tratamiento-aviso-admin" visible="false" />
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaTratamientos" styleClass="tabla-tratamientos">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                <TableColumn fx:id="colDescripcion" prefWidth="340.0" text="Descripción" />
                <TableColumn fx:id="colCosto" prefWidth="100.0" text="Costo (Q)" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10.0" styleClass="tratamiento-formulario">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="12.0" />
            </padding>
            <children>
                <Label styleClass="etiqueta" text="Código interno" />
                <TextField fx:id="txtCodigo" promptText="Ej. TRT-004" />

                <Label styleClass="etiqueta" text="Nombre del tratamiento" />
                <TextField fx:id="txtNombre" promptText="Ej. Blanqueamiento dental" />

                <Label styleClass="etiqueta" text="Descripción" />
                <TextArea fx:id="txtDescripcion" prefRowCount="2" promptText="Detalle del procedimiento" wrapText="true" />

                <Label styleClass="etiqueta" text="Costo estándar (Q)" />
                <TextField fx:id="txtCosto" promptText="Ej. 850.00" />

                <HBox spacing="10.0" styleClass="barra-botones">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onMouseClicked="#onGuardar" styleClass="btn-primario" text="Guardar" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onMouseClicked="#onActualizar" styleClass="btn-secundario" text="Actualizar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onMouseClicked="#onLimpiar" styleClass="btn-ghost" text="Limpiar" />
                        <Button fx:id="btnVolver" mnemonicParsing="false" onMouseClicked="#onVolver" styleClass="btn-ghost" text="Volver" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>

</BorderPane>
